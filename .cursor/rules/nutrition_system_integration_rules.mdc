    { allergies: [], restrictions: null },           // Empty array and null
    { allergies: [''], restrictions: [''] },         // Arrays with empty strings
    { allergies: undefined, restrictions: undefined } // Undefined values
  ];
  
  for (const testCase of boundaryTestCases) {
    const { error } = await supabase
      .from('dietary_preferences')
      .upsert({
        user_id: testUser.id,
        diet_type: 'standard',
        allergies: testCase.allergies || [],
        restrictions: testCase.restrictions || [],
        meal_frequency: 3
      });
      
    expect(error).toBeNull();
  }
};

// ✅ REQUIRED: Numeric boundary testing
const testNumericBoundaries = async () => {
  const boundaryValues = [
    { bmr: 0, tdee: 0 },                    // Zero values
    { bmr: 99999, tdee: 99999 },            // Large values
    { bmr: 1200.5, tdee: 1800.75 },         // Decimal values
    { bmr: -100, tdee: -200 }               // Negative values (should fail)
  ];
  
  for (const values of boundaryValues) {
    const { error } = await supabase
      .from('nutrition_plans')
      .insert({
        user_id: testUser.id,
        bmr: values.bmr,
        tdee: values.tdee,
        macros: { protein: 100, carbs: 200, fat: 70 }
      });
      
    if (values.bmr < 0 || values.tdee < 0) {
      expect(error).not.toBeNull(); // Should fail for negative
    } else {
      expect(error).toBeNull();
    }
  }
};
```

## 🚧 CRITICAL ANTI-PATTERNS TO AVOID

### **Nutrition System Specific Anti-Patterns**
❌ **NEVER hardcode nutrition logic when food/recipe databases are available**  
❌ **NEVER assume food item names match exactly - implement fuzzy matching**  
❌ **NEVER ignore medical conditions in dietary recommendations**  
❌ **NEVER skip allergy/restriction validation in meal planning**  
❌ **NEVER test nutrition AI without validating dietary safety awareness**  
❌ **NEVER create meal plans without macro/micro nutrient validation**  
❌ **NEVER ignore caloric requirements based on user profile**  
❌ **NEVER assume OpenAI understands specific food brand names**  
❌ **NEVER skip portion size validation in meal recommendations**  
❌ **NEVER test edge cases without extreme restriction scenarios**
❌ **NEVER assume database columns without checking migration files** *(Phase 3)*
❌ **NEVER skip concurrent user testing for production readiness** *(Phase 3)*
❌ **NEVER ignore foreign key constraints in test data** *(Phase 3)*
❌ **🚨 CRITICAL: NEVER treat configuration bugs as "successful integration"** *(Phase 5)*
❌ **🚨 CRITICAL: NEVER celebrate database table/column name errors as "graceful degradation"** *(Phase 5)*

