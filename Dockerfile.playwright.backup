# Playwright Dockerfile for E2E Testing
# Optimized for running Playwright tests in Docker with all necessary dependencies

FROM mcr.microsoft.com/playwright:v1.41.0-focal

# Set working directory
WORKDIR /app

# Set environment variables
ENV NODE_ENV=test
ENV CI=true

# Copy package files
COPY package*.json ./

# Install dependencies
RUN npm ci --only=production=false

# Install Playwright browsers (already included in the base image, but ensure latest)
RUN npx playwright install --with-deps

# Copy source code
COPY . .

# Create directories for test artifacts
RUN mkdir -p test-results playwright-report

# Set proper permissions
RUN chmod -R 777 test-results playwright-report

# Default command - can be overridden
CMD ["npx", "playwright", "test", "--reporter=html"]
