        K2A@{ shape: rounded, label: "Displays the next week's daily workouts (e.g., if current week is week 1, then clicking right will display week 2)"}
        K2B@{ shape: display, label: "If user toggles to a future week, the individual daily workout cards now contain a 'View Workout' button instead of a 'View/Log Workout' button"}
        K2C@{ shape: braces, label: "This ensures the user completes and logs all daily workouts in the current week before being able to log/complete workouts in future weeks"}
        K3@{ shape: trap-t, label: "User clicks left arrow"}
        K3A@{ shape: rounded, label: "Displays the previous week's daily workouts (e.g., if current week is week 1, then clicking left will display final week - which is considered a future week)"}
  end
