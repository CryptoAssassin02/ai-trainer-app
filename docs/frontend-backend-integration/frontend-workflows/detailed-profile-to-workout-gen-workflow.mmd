subgraph ten["How System/DB Determines the Current Week"]
        J1@{ shape: cyl, label: "The system and DB will track what week is the current week based on either:"}
        J1A@{ shape: cyl, label: "**1)** 1 calendar week (6 additional days) has passed since user completed/logged first workout of week regardless if all daily workouts were completed or not"}
        J1B@{ shape: braces, label: "For example, user logs 1st Week 1 workout on Monday, then following Monday the Current Week will be Week 2 even if not all Week 1 workouts were completed/logged"}
        J1C@{ shape: cyl, label: "**2)** All current week daily workouts were completed prior to end of 1 calendar week"}
        J1D@{ shape: braces, label: "For example, user has 4 daily workouts in Week 1 (Day 1, Day 2, Day 3, & Day 4) and completes all workouts in 6 calendar days (leaving 1 day remaining in calendar week)"}
  end
